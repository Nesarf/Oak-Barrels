# Normalize line endings across platforms.
# Stored with LF; checked out per the rules below.
* text=auto eol=lf

# Explicitly text
*.dart    text
*.yaml    text
*.yml     text
*.md      text
*.h       text
*.hpp     text
*.c       text
*.cc      text
*.cpp     text
*.cmake   text
CMakeLists.txt text
*.json    text
*.toml    text

# Never touch these
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.ico     binary
*.ttf     binary
*.otf     binary

# Native artefacts (see .gitignore — these should not be committed at all)
*.dll     binary
*.so      binary
*.dylib   binary
*.a       binary
*.lib     binary
*.pdb     binary

# Audio
*.wav     binary
*.ogg     binary

# Keep host-native scripts working on their own platform
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Linguist hints
src/relay/** linguist-language=C++

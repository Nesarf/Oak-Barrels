# Dart / pub
.dart_tool/
.packages
.pub-cache/
.pub/
build/
pubspec.lock

# Native build output
src/build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exp
*.pdb
*.ilk

# Third-party SDK content must never be committed.
# The relay links nothing at build time, so nothing here should ever be needed.
third_party/
vendor/
*_sdk/
sdk/
*.wproj

# Engine runtime artefacts must not be committed either.
*.bnk
*.wem

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Machine-local configuration. If a setting cannot be committed safely it
# should be supplied at run time, not checked in.
*.local.yaml
*.local.yaml.*
env.local.*
